# Doxygen configuration for robot_control. Configured by cmake/Docs.cmake;
# build with `cmake --build build --target docs`. Only settings that differ
# from Doxygen's defaults are listed, so this file stays readable and works
# across Doxygen versions.

PROJECT_NAME           = "robot_control"
PROJECT_BRIEF          = "Real-time control core for the reBot Arm B601-RS"
PROJECT_NUMBER         = @RC_GIT_SHA@
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
STRIP_FROM_PATH        = @CMAKE_SOURCE_DIR@
STRIP_FROM_INC_PATH    = @CMAKE_SOURCE_DIR@/core/rt/include \
                         @CMAKE_SOURCE_DIR@/core/bridge/include \
                         @CMAKE_SOURCE_DIR@/core/telemetry/include

# What is documented: the public headers, plus the README and the design
# documents as pages. Tests, benches and apps are not API.
INPUT                  = @CMAKE_SOURCE_DIR@/README.md \
                         @CMAKE_SOURCE_DIR@/core/README.md \
                         @CMAKE_SOURCE_DIR@/docs/ROADMAP.md \
                         @CMAKE_SOURCE_DIR@/docs/adr \
                         @CMAKE_SOURCE_DIR@/core/rt/include \
                         @CMAKE_SOURCE_DIR@/core/bridge/include \
                         @CMAKE_SOURCE_DIR@/core/telemetry/include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.md
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/README.md
MARKDOWN_SUPPORT       = YES
# Headers link to docs/adr with GitHub-relative paths; see docs/doxygen_filter.py.
INPUT_FILTER           = "@Python3_EXECUTABLE@ @CMAKE_SOURCE_DIR@/docs/doxygen_filter.py"

# The headers already carry the reasoning in `///` blocks; JAVADOC_AUTOBRIEF
# makes the first sentence of each the hover-style summary.
JAVADOC_AUTOBRIEF      = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
SOURCE_BROWSER         = YES
BUILTIN_STL_SUPPORT    = YES

# Keep the docs honest: an undocumented public symbol is a warning, and
# cmake/Docs.cmake can promote warnings to errors for CI.
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_INCOMPLETE_DOC = NO
WARN_AS_ERROR          = @DOXYGEN_WARN_AS_ERROR@
QUIET                  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES

# Diagrams only when Graphviz is installed; cmake/Docs.cmake decides.
HAVE_DOT               = @DOXYGEN_HAVE_DOT@
